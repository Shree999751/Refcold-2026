# ─────────────────────────────────────────────────────────────
# CryoSense server configuration
# ─────────────────────────────────────────────────────────────

# Port the API listens on. The React dev server proxies /api here.
PORT=5000

# Origin of the React app, for CORS. Comma-separate several origins.
CLIENT_ORIGIN=http://localhost:5173

# ── Firebase (Cloud Firestore) ───────────────────────────────
# Firebase console > Project settings > Service accounts > Generate new private key.
#
# OPTION A (easiest): save the downloaded JSON as server/serviceAccountKey.json
# and keep this line:
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
#
# OPTION B: paste the three values from that JSON file below instead
# (leave FIREBASE_SERVICE_ACCOUNT_PATH empty). Keep the private key in
# double quotes on ONE line, with the \n sequences exactly as in the JSON.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# How often (seconds) a telemetry snapshot of every compressor is written.
# 300 s keeps you well inside the Firestore free tier (20k writes/day).
FIRESTORE_SNAPSHOT_INTERVAL_SEC=300

# ── Simulation ───────────────────────────────────────────────
# Real milliseconds per simulated hour at speed 1.
SIM_TICK_MS=2000
# Simulated hours per tick when the server starts (1 to 24).
SIM_SPEED=1
# Let faults start on their own now and then (true/false).
SIM_AUTO_FAULTS=true
# Change to get a different, but repeatable, fleet.
SIM_SEED=2026
